[Unit]
Description=eve-corps.online (Flask/gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/home/web/corps
# Apache proxies here and logs the requests itself.
ExecStart=/home/web/corps/.venv/bin/gunicorn -b 127.0.0.1:8002 -w 3 wsgi:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
